// Phase 1 panel registration + build matrix for 8773G QSPI panels.
//
// Call from the west workspace root (the directory containing zephyrproject/).
// The agent must provide west and the Zephyr toolchain, same as a normal build.
//
// registry.py --check is fast and catches:
//   - Kconfig/CMake/SConscript registration drift
//   - stale generated files
// panel_matrix.py --all builds every manifest panel in its own build dir.
pipeline {
    agent any

    environment {
        ZEPHYR_TOOLCHAIN_VARIANT = 'zephyr'
        // Set to your Zephyr SDK installation, or configure it on the agent.
        ZEPHYR_SDK_INSTALL_DIR = 'E:/Programs/Zephyr-SDK/zephyr-sdk-0.16.8'
    }

    stages {
        stage('Panel registry') {
            steps {
                sh 'python modules/device/registry/panel_registry.py --check'
            }
        }

        stage('8773G QSPI build matrix') {
            steps {
                // Use --jobs N when the agent has enough CPU/disk.
                sh 'python modules/device/ci/panel_matrix.py --all --jobs 1'
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'zephyrproject/realtek-app/samples/honeygui/build_ci/*.log', allowEmptyArchive: true
        }
    }
}
